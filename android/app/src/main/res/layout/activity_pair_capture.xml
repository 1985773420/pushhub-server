<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#101820">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp" android:text="扫描 PushHub 配对二维码"
        android:textColor="#FFFFFF" android:textSize="22sp" android:gravity="center" />
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        app:zxing_framing_rect_width="280dp" app:zxing_framing_rect_height="280dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp" android:text="将控制台的配对二维码放入正方形框内\n请确认手机可访问所选内网或公网地址\n按返回键取消，可手动填写地址和配对码"
        android:textColor="#FFFFFF" android:textSize="16sp" android:gravity="center" />
</LinearLayout>
